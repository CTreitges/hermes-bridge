[Unit]
# Vorlage: /home/chris durch das eigene Home ersetzen, z. B.
#   sed "s|/home/chris|$HOME|g" deploy/hermes-bridge.service > ~/.config/systemd/user/hermes-bridge.service
Description=hermes-bridge — Sprachauftraege von WhisperLoom an Hermes (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/chris/hermes-bridge
# Fuehrendes "-": der Dienst startet auch ohne .env. Er ist dann fail-closed —
# ohne BRIDGE_TOKEN beantwortet er jeden Auftrag mit 401, /health meldet
# "configured": false. So laesst sich die Route aufbauen, bevor das Token da ist.
EnvironmentFile=-/home/chris/hermes-bridge/.env
ExecStart=/home/chris/hermes-bridge/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8093
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
