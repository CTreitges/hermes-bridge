# Vorlage. Die echte .env legt der Nutzer an: chmod 600, niemals ins Repo.
#
#   cp .env.example .env && chmod 600 .env
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"   # Token erzeugen
#
# Token, das die App im Authorization-Header mitschickt.
BRIDGE_TOKEN=hier-ein-langes-zufaelliges-token

# Optional: Telegram-Chat-ID. Leer lassen — dann holt der Dienst sie beim Start
# selbst ueber `hermes send --list telegram`.
HERMES_CHAT_ID=
